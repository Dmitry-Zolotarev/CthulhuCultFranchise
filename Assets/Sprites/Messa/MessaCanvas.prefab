  visitorTypeLabel2: {fileID: 1522406224188391046}
  visitorTypeStrings2:
  - "\u043E\u0444\u0438\u0441\u043D\u0438\u043A\u0430\u043C"
  - "\u0441\u0442\u0443\u0434\u0435\u043D\u0442\u0430\u043C"
  - "\u043F\u0435\u043D\u0441\u0438\u043E\u043D\u0435\u0440\u0430\u043C"
  - "\u0431\u043B\u043E\u0433\u0435\u0440\u0430\u043C"
  - "\u044D\u0437\u043E\u0442\u0435\u0440\u0438\u043A\u0430\u043C"
  cookieBonus: {fileID: 5373559353453789756}
  premiumFlyerConversionBonus: {fileID: 703770732570607205}
  beautifulAltarBonus: {fileID: 7077327109838579364}
  baseChanceLabel: {fileID: 8801823033039793355}
  sermonMultiplierLabel: {fileID: 7451442095711479523}
  esotericBonusLabel: {fileID: 7920585399178318845}
  cookieBonusLabel: {fileID: 3791662753691666150}
  flyerConversionBonusLabel: {fileID: 2913662693539564431}
  altarBonusLabel: {fileID: 8439570154943901436}
  firstRowBonus: {fileID: 1279242168396428357}
  premiumCandleBonus: {fileID: 542578389416239031}
  premiumFlyerMoneyBonus: {fileID: 8477965853415547974}
  bonusesHeader: {fileID: 4086910758539548811}
  firstRowBonusLabel: {fileID: 569205082531970814}
  premiumCandleBonusLabel: {fileID: 8221567963587826734}
  premiumFlyerBonusLabel: {fileID: 5311013955577407052}
  cthulhuCommentLabel: {fileID: 6493982807512298706}
  cthulhuComments:
  - "\u041E\u0444\u0438\u0441\u043D\u0438\u043A\u0438 \u043F\u043B\u0430\u0442\u044F\u0442
    \u0445\u043E\u0440\u043E\u0448\u043E. \u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C\n\u0431\u043E\u043B\u044C\u0448\u0435
    \u0434\u0435\u043D\u0435\u0433 - \u0440\u0430\u0431\u043E\u0442\u0430\u0439 \u0441
    \u043D\u0438\u043C\u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
  - "\u0421\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u0447\u0430\u0449\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u0430\u0434\u0435\u043F\u0442\u0430\u043C\u0438 \u043A\u0443\u043B\u044C\u0442\u0430."
  - "\u041F\u0435\u043D\u0441\u0438\u043E\u043D\u0435\u0440\u044B \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u044E\u0442
    \u043E\u0442\u0442\u043E\u043A \u0441\u0442\u0430\u0440\u044B\u0445 \u0430\u0434\u0435\u043F\u0442\u043E\u0432."
  - "\u0411\u043B\u043E\u0433\u0435\u0440\u044B \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442
    \u0447\u0438\u0441\u043B\u043E \u043B\u044E\u0434\u0435\u0439 \u043D\u0430 \u0443\u043B\u0438\u0446\u0435."
  - "\u042D\u0437\u043E\u0442\u0435\u0440\u0438\u043A\u0438 \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0442
    \u0448\u0430\u043D\u0441 \u043A\u043E\u043D\u0432\u0435\u0440\u0441\u0438\u0438\n\u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439
    \u0432 \u0430\u0434\u0435\u043F\u0442\u043E\u0432."
